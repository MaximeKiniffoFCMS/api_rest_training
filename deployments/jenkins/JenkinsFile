properties([
    parameters([
        stringParam('BRANCH', 'main', 'Branch to build')
    ])
])

pipeline {
    agent any
    
    stages {
        stage('Checkout') {
            steps {
                checkout([$class: 'GitSCM', branches: [[name: params.BRANCH]], userRemoteConfigs: [[url: 'https://github.com/kiniffo/api_rest_training.git']]])
            }
        }
    }
}